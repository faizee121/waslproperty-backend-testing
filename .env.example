NODE_ENV=development
PORT=4100

# Own PostgreSQL instance — never shared with WaslSign
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/wasl_property

# Auth
JWT_ACCESS_SECRET=change_me_access
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change_me_refresh
JWT_REFRESH_EXPIRES_IN_DAYS=30
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false
# 'lax' for local dev / same-site deployments. Set to 'none' (and
# COOKIE_SECURE=true, COOKIE_DOMAIN=) when frontend and backend are on
# different registrable domains, e.g. two separate Render services.
COOKIE_SAME_SITE=lax

# CORS — comma-separated list of allowed origins
FRONTEND_URL=http://localhost:5174

LOG_LEVEL=debug

# Resident invitations (M6.5)
INVITE_TOKEN_EXPIRES_IN_HOURS=72

# S3 (M6.5) — maintenance request photo attachments. Credentials are picked
# up from the default AWS SDK credential chain (e.g. ~/.aws/credentials);
# only region + bucket are required here.
AWS_REGION=me-central-1
S3_BUCKET_NAME=wasl-property-uploads-dev
MAINTENANCE_ATTACHMENT_MAX_FILES=5
MAINTENANCE_ATTACHMENT_MAX_SIZE_MB=10

# --- Outbound email ---
# Production/staging transport — Resend's HTTPS API. Required anywhere
# outbound SMTP ports are blocked (e.g. Render's Free Web Service tier
# blocks 25/465/587 entirely). Get a key at https://resend.com.
# RESEND_API_KEY=
EMAIL_FROM=Wasl Property <no-reply@waslproperty.dev>

# SMTP — local-development-only fallback, used only when RESEND_API_KEY is
# unset. Leave SMTP_HOST unset too in development to fall back further, to
# an ad-hoc Ethereal test inbox (preview URL is logged).
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
SMTP_FROM=Wasl Property <no-reply@waslproperty.dev>

BACKEND_PUBLIC_URL=http://localhost:4100

# --- WaslSign integration (M9-A) ---
# Leave unset in an environment that shouldn't offer SIGNATURE_ONLY /
# APPROVAL_THEN_SIGNATURE workflows — WaslSignService treats that as
# "unavailable", not a startup failure. clientId/clientSecret come from
# waslsign-backend's scripts/create-service-client.ts; the webhook secret
# must exactly match that WaslSign deployment's own WASLSIGN_WEBHOOK_SECRET.
# WASLSIGN_API_BASE_URL=
# WASLSIGN_SERVICE_CLIENT_ID=
# WASLSIGN_SERVICE_CLIENT_SECRET=
# WASLSIGN_WEBHOOK_SECRET=

# Approval & Acceptance requirements (when a quote/variation needs approval
# and/or signature) are configured per-organisation in-app, under
# Organisation Settings -> Approval & Acceptance — not here.

# --- Wasl AI (M14) ---
# AI_ENABLED is the platform-wide kill switch — leave false in any
# environment that shouldn't offer Wasl AI at all. Even when true, an
# organisation only actually gets AI once it ALSO enables it under
# Organisation Settings -> Wasl AI (Organisation.aiEnabled), and only a user
# holding the `ai.use` capability can use it — all three are required.
# AI_ENABLED=false
# AI_PROVIDER=deepseek
# DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_ANALYSIS_MODEL=deepseek-reasoner
# Reserved for a future write-actions milestone — no write action exists
# yet; M14 is strictly read-only regardless of this flag.
# AI_WRITE_ACTIONS_ENABLED=false

# --- Property Document Intelligence (M15) ---
# Cost/execution bounds for the AI-assisted strata-plan onboarding
# pipeline (upload -> OCR -> AI interpretation -> validation). All have
# sensible defaults below; uncomment only to change them. Reuses the same
# AI_PROVIDER/DEEPSEEK_* config above for the interpretation stage — no
# separate provider credentials are needed.
# DOCUMENT_ANALYSIS_MAX_FILE_SIZE_MB=15
# DOCUMENT_ANALYSIS_MAX_PAGES=20
# DOCUMENT_ANALYSIS_MAX_OCR_TEXT_CHARS_PER_PAGE=6000
# DOCUMENT_ANALYSIS_MAX_AI_OUTPUT_TOKENS=3000
# DOCUMENT_ANALYSIS_OCR_TIMEOUT_MS=90000
# DOCUMENT_ANALYSIS_PROVIDER_TIMEOUT_MS=60000
# DOCUMENT_ANALYSIS_TOTAL_TIMEOUT_MS=240000
# DOCUMENT_ANALYSIS_STUCK_THRESHOLD_MS=300000

# --- Vision fallback (M15.1) ---
# A SEPARATE kill switch from AI_ENABLED above — OCR + text interpretation
# stays the default path even when AI is on; vision only runs when this is
# explicitly true AND a critical field (the entitlement schedule, plan
# number, or address) genuinely failed OCR/reconciliation. Requires a
# vision-capable model — deepseek-flash (DeepSeek-V4.1-Flash, GA Sept
# 2026) supports image input on the same DEEPSEEK_API_KEY/endpoint as the
# text models above, so no separate vendor credentials are needed for the
# default 'deepseek' VISION_PROVIDER.
# DOCUMENT_ANALYSIS_VISION_ENABLED=false
# VISION_PROVIDER=deepseek
# DEEPSEEK_VISION_MODEL=deepseek-flash
# DOCUMENT_ANALYSIS_VISION_MAX_PAGES=1
# DOCUMENT_ANALYSIS_VISION_RENDER_SCALE=4
# DOCUMENT_ANALYSIS_VISION_TIMEOUT_MS=60000
# DOCUMENT_ANALYSIS_VISION_MAX_OUTPUT_TOKENS=2000
# DOCUMENT_ANALYSIS_VISION_MAX_RETRIES=1
